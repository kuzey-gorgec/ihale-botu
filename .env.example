DATABASE_URL=postgresql://ihale:ihale_dev_pw@localhost:5432/ihale_botu

# Ihale kategori siniflandirmasi - once Ollama (yerel/ucretsiz), o calismazsa
# Groq (ucretsiz kota), o da yoksa Anthropic dener. Hicbiri yoksa siniflandirma
# atlanir, category NULL kalir.

# Ollama - yerelde "ollama serve" calisiyor ve model pull edilmis olmali
# (orn. `ollama pull qwen2.5`). Varsayilanlar zaten bunlar, degistirmen gerekmez.
OLLAMA_URL=http://localhost:11434
# `ollama list` ciktisindaki tam etiketi kullan (orn. sadece "qwen2.5" degil,
# "qwen2.5:7b" gibi) - Ollama etiket eslesmezse 404 donuyor.
OLLAMA_MODEL=qwen2.5:7b

# Groq - ucretsiz API key: https://console.groq.com/keys
# Hesabina hangi modellerin acik oldugunu su komutla gorebilirsin:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Opsiyonel son care - Claude API ile siniflandirma icin.
ANTHROPIC_API_KEY=

# Kisi/iletisim bulma katmani (scripts/find_contacts.py) icin.
# Google'in kendi Custom Search API'si yeni musterilere kapali oldugundan SerpAPI kullanilir.
# https://serpapi.com/users/sign_up -> ucretsiz hesap ac (ayda 250 sorgu, aylik yenilenir)
# -> dashboard'daki "Your Private API Key"i buraya yaz.
SERPAPI_API_KEY=
